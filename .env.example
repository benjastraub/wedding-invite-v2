# Copy this file to `.env` for local development. Never commit real values.
#
# Everything below is optional locally: without GOOGLE_SPREADSHEET_ID the
# server starts but the /api routes that touch the sheet return errors.

# Port for the local Express API (Vite proxies /api to it). Cloud Run sets PORT itself.
PORT=8080

# The Google Sheet powering the site — the ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
# Create a blank Google Sheet (see README), then run: npm run sheet:setup
GOOGLE_SPREADSHEET_ID=

# Optional Google Drive folder holding the site photos (a hero.* image +
# any gallery photos). Share the FOLDER with the service account email as
# VIEWER, then put its ID here — from the folder URL:
# https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
# Leave empty to run without a photo gallery.
GOOGLE_DRIVE_FOLDER_ID=

# LOCAL-ONLY service account key for Google Sheets access.
# On Cloud Run leave this unset: the service runs as the service account
# and authenticates automatically (no key file in production).
# Download the key with:
#   gcloud iam service-accounts keys create service-account-key.json \
#     --iam-account=wedding-invite@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=

# Used by scripts/export-links.mjs to build the personalized guest URLs.
# Set it to your Cloud Run URL (e.g. https://wedding-invite-abc-uc.a.run.app).
BASE_URL=
